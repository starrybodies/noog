    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "buffer": "6.0.3",
    "nsfwjs": "4.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.58.2"
  },
  "engines": {
    "node": ">=22 <27"
  }
}
